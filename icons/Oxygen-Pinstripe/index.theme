[Icon Theme]
Name=Oxygen Pinstripe
Comment=Mac OS X 10.2 Aqua icon theme and menu-extra symbolic glyphs
Inherits=oxygen,breeze,hicolor
Example=system-file-manager
DisplayDepth=32
DesktopDefault=48
ToolbarDefault=32
MainToolbarDefault=32
SmallDefault=16
PanelDefault=22
FollowsColorScheme=true
Directories=16x16/actions,22x22/actions,24x24/actions,32x32/actions,32x32@2/actions,48x48/actions,16x16/places,22x22/places,32x32/places,48x48/places,64x64/places,128x128/places,16x16/devices,22x22/devices,32x32/devices,48x48/devices,64x64/devices,128x128/devices,16x16/apps,22x22/apps,32x32/apps,48x48/apps,64x64/apps,128x128/apps,16x16/categories,22x22/categories,32x32/categories,48x48/categories,64x64/categories,128x128/categories,16x16/applets,22x22/applets,32x32/applets,48x48/applets,symbolic/actions,symbolic/apps,symbolic/devices,symbolic/emblems,symbolic/mimetypes,symbolic/places,symbolic/status,panel/status

